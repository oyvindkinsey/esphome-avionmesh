diff --git a/include/recsrmesh/csrmesh.h b/include/recsrmesh/csrmesh.h
index 0f2994b..598505d 100644
--- a/include/recsrmesh/csrmesh.h
+++ b/include/recsrmesh/csrmesh.h
@@ -9,12 +9,29 @@

 #include <functional>

+// Additive authenticated observer API; absent in released v1.1.3.
+#define RECSRMESH_RX_OBSERVER_API 1
+
 namespace csrmesh {

 // Callback for decrypted MCP messages
 using RxCallback = std::function<void(uint16_t mcp_source, uint16_t crypto_source, uint8_t opcode,
                                       const uint8_t *payload, size_t payload_len)>;

+// Borrowed view valid only during the observer call. Copy before returning.
+// crypto_source and sequence are authenticated by MCP HMAC verification;
+// mcp_source is the MCP header field (often a destination), not sender identity.
+struct RxMessage {
+    uint16_t mcp_source;
+    uint16_t crypto_source;
+    uint32_t sequence;
+    uint8_t opcode;
+    const uint8_t *payload;
+    size_t payload_len;
+    uint32_t received_ms;
+};
+using RxObserver = std::function<void(const RxMessage &)>;
+
 // Callback for discovered unassociated devices
 using DiscoveryCallback =
     std::function<void(const uint8_t *uuid, size_t uuid_len, uint32_t uuid_hash)>;
@@ -27,6 +44,8 @@ struct MeshContext {
     uint8_t masp_key[KEY_LEN] = {};

     RxCallback rx_cb;
+    RxObserver rx_observer;
+    uint32_t rx_received_ms = 0;

     bool discovering = false;
     DiscoveryCallback discovery_cb;
@@ -40,6 +59,13 @@ Error init(MeshContext &ctx, mtl::BleWriteFn ble_write, const char *passphrase);

 void set_rx_callback(MeshContext &ctx, RxCallback cb);

+// Independent of the legacy RX handler; nullptr unregisters. Called after it,
+// once per successfully authenticated and parsed MCP message (no replay filter).
+// Timestamp is the completing notification receipt time; LOW-only packets use
+// their original LOW receipt time even when poll() flushes them much later.
+// Callbacks run synchronously and must not block or reenter this MeshContext.
+void set_rx_observer(MeshContext &ctx, RxObserver observer);
+
 void feed_notify(MeshContext &ctx, Characteristic ch, const uint8_t *data, size_t len,
                  uint32_t now_ms);

diff --git a/src/csrmesh.cpp b/src/csrmesh.cpp
index 221fac4..fda6287 100644
--- a/src/csrmesh.cpp
+++ b/src/csrmesh.cpp
@@ -45,12 +45,19 @@ void set_rx_callback(MeshContext &ctx, RxCallback cb) {
     ctx.rx_cb = std::move(cb);
 }

+void set_rx_observer(MeshContext &ctx, RxObserver observer) {
+    ctx.rx_observer = std::move(observer);
+}
+
 void feed_notify(MeshContext &ctx, Characteristic ch, const uint8_t *data, size_t len,
                  uint32_t now_ms) {
+    ctx.rx_received_ms = now_ms;
     mtl::feed(ctx.mtl, ch, data, len, now_ms);
 }

 void poll(MeshContext &ctx, uint32_t now_ms) {
+    // MTL may flush a LOW-only packet here. Keep receipt time, not poll time.
+    ctx.rx_received_ms = ctx.mtl.low_timestamp_ms;
     mtl::poll(ctx.mtl, now_ms);
 }

@@ -230,7 +237,7 @@ static bool handle_masp(MeshContext &ctx, const uint8_t *data, size_t len) {
 }

 static void handle_mcp(MeshContext &ctx, const uint8_t *data, size_t len) {
-    if (!ctx.rx_cb)
+    if (!ctx.rx_cb && !ctx.rx_observer)
         return;

     mcp_crypto::Decrypted result;
@@ -241,7 +248,12 @@ static void handle_mcp(MeshContext &ctx, const uint8_t *data, size_t len) {
     if (!mcp::parse({result.decrypted, result.decrypted_len}, parsed))
         return;

-    ctx.rx_cb(parsed.source, result.source, parsed.opcode, parsed.payload, parsed.payload_len);
+    const RxMessage message{parsed.source, result.source, result.seq, parsed.opcode,
+                            parsed.payload, parsed.payload_len, ctx.rx_received_ms};
+    if (ctx.rx_cb)
+        ctx.rx_cb(parsed.source, result.source, parsed.opcode, parsed.payload, parsed.payload_len);
+    if (ctx.rx_observer)
+        ctx.rx_observer(message);
 }

 }  // namespace csrmesh
diff --git a/tests/RX_OBSERVER.md b/tests/RX_OBSERVER.md
new file mode 100644
index 0000000..13fe6ae
--- /dev/null
+++ b/tests/RX_OBSERVER.md
@@ -0,0 +1,46 @@
+# Authenticated RX observer candidate
+
+This additive API is an unpublished candidate against recsrmesh commit
+`d97c42f653f0079cd614dec31930475e428bf2e2`, the submodule in avionmesh-cpp
+v1.1.3 (`0cf84e0b946ace134a401503db3b8ec62e801c2c`). It does not exist in
+released v1.1.3. `RECSRMESH_RX_OBSERVER_API == 1` advertises this contract.
+
+`set_rx_observer(MeshContext &, RxObserver)` receives `const RxMessage &`
+with MCP header field, authenticated crypto source, authenticated sequence,
+opcode, borrowed payload bytes/length, and receipt timestamp. It runs after the
+existing native RX callback. Removing/replacing it does not replace native RX,
+MASP association, discovery, or MTL reassembly. No authentication happens twice.
+Payload lifetime ends at callback return; clients must copy needed bytes. Callback
+code must be bounded, nonblocking, and must not reenter the context. As before,
+callers must serialize feed/poll/init/registration access to a MeshContext; this
+API does not introduce a new concurrency guarantee or a new task.
+
+Timestamp is the completing HIGH receipt time, or the original LOW receipt time
+for a LOW-only timeout flush. It uses the caller-supplied monotonic milliseconds,
+including wrap. The observer only receives successful authentication plus MCP
+parse; it is not a replay filter. Consumers must still gate source identity on
+inventory product, apply duplicate/freshness policy, and discard offline events.
+The MCP header field is not the authenticated sender identity.
+
+Run the isolated dispatch/reassembly contract fixture without external packages:
+
+```sh
+clang++ -std=c++20 -Wall -Wextra -Werror -fsanitize=address,undefined -Iinclude \
+  tests/test_rx_observer.cpp src/csrmesh.cpp src/mtl.cpp src/mcp.cpp \
+  -o /tmp/recsrmesh-rx-observer-test
+/tmp/recsrmesh-rx-observer-test
+```
+
+The fixture links the actual CSRMesh dispatcher, MTL reassembler and MCP parser
+with deterministic crypto/protocol doubles. It exercises authentication error
+return gating, parse failures, original callback order/preservation, observer
+removal and observer-only use, copied source/sequence/payload metadata, one decrypt
+per message, HIGH/split/LOW-timeout receipt timestamps, clock wrap, native discovery
+and consumed association packets, and reinitialization/failure clearing observers.
+It does not validate cryptographic correctness; retain the library's independent
+crypto known-answer tests and run the full Mbed TLS suite before release.
+
+This changes MeshContext layout, so consumers must rebuild and must not mix
+headers/binaries. A released recsrmesh revision plus an avionmesh-cpp submodule
+bump and ESPHome dependency pin are required before claiming this is available
+by default. No release/push/PR is made by this patch.
diff --git a/tests/test_rx_observer.cpp b/tests/test_rx_observer.cpp
new file mode 100644
index 0000000..8167f6e
--- /dev/null
+++ b/tests/test_rx_observer.cpp
@@ -0,0 +1,141 @@
+// Dispatch contract tests: real csrmesh.cpp, MTL reassembly and MCP parser;
+// deterministic crypto/protocol doubles isolate authentication success/failure.
+// These do not replace the independent crypto known-answer tests.
+#include "recsrmesh/csrmesh.h"
+#include <cassert>
+#include <cstring>
+#include <vector>
+
+using namespace csrmesh;
+namespace {
+Error decrypt_error = Error::Ok;
+Error key_error = Error::Ok;
+uint16_t authenticated_source = 0x8123;
+uint32_t authenticated_sequence = 0x123456;
+unsigned decrypt_calls = 0, protocol_calls = 0;
+bool masp_valid = false;
+}
+namespace csrmesh::mcp_crypto {
+Error generate_key(ByteSpan, uint8_t *) { return key_error; }
+Error decrypt_packet(const uint8_t *, ByteSpan data, Decrypted &result) {
+    ++decrypt_calls;
+    if (decrypt_error != Error::Ok) return decrypt_error;
+    if (data.size() > sizeof(result.decrypted)) return Error::BufferTooSmall;
+    std::memcpy(result.decrypted, data.data(), data.size());
+    result.decrypted_len = data.size();
+    result.source = authenticated_source;
+    result.seq = authenticated_sequence;
+    return Error::Ok;
+}
+Error random_seq(uint32_t &) { return Error::Crypto; }
+size_t make_packet(const uint8_t *, uint32_t, ByteSpan, uint8_t *, size_t) { return 0; }
+}
+namespace csrmesh::crypto {
+Error derive_key(const char *, const char *, size_t, uint8_t *) { return key_error; }
+Error verify_packet_mac(ByteSpan packet, const uint8_t *, size_t *len, bool *valid) {
+    *len = packet.size(); *valid = masp_valid; return Error::Ok;
+}
+void xor_masp_packet(const uint8_t *in, uint8_t *out, size_t len) { std::memcpy(out, in, len); }
+uint32_t uuid_to_hash31(ByteSpan) { return 123; }
+Error add_packet_mac(ByteSpan, const uint8_t *, uint8_t, uint8_t *, size_t *) { return Error::Crypto; }
+}
+namespace csrmesh::masp {
+void set_target(Context &, uint32_t) {}
+size_t build_device_id_announce(const Context &, uint8_t *, size_t) { return 0; }
+}
+namespace csrmesh::protocol {
+size_t get_initial_request(Context &, uint8_t *, size_t) { return 0; }
+size_t process(Context &ctx, const uint8_t *, size_t, uint8_t *, size_t) {
+    ++protocol_calls; ctx.state = State::Complete; return 0;
+}
+bool is_complete(const Context &ctx) { return ctx.state == State::Complete; }
+bool is_error(const Context &) { return false; }
+void cleanup(Context &) {}
+}
+
+int main() {
+    MeshContext ctx;
+    const auto write = [](Characteristic, const uint8_t *, size_t, bool) { return 0; };
+    assert(init(ctx, write, "test-passphrase") == Error::Ok);
+    // Header deliberately differs from authenticated sender.
+    uint8_t frame[] = {0x10, 0x01, 0x73, 0, 10, 1, 16, 1, 0, 255, 0, 0, 0};
+    std::vector<int> order;
+    unsigned native_calls = 0, observer_calls = 0;
+    uint32_t timestamp = 0;
+    std::vector<uint8_t> copied;
+    set_rx_callback(ctx, [&](uint16_t header, uint16_t source, uint8_t opcode,
+                             const uint8_t *payload, size_t len) {
+        ++native_calls; order.push_back(1);
+        assert(header == 272 && source == authenticated_source && opcode == 0x73);
+        assert(len == 10 && payload[6] == 255);
+    });
+    auto observer = [&](const RxMessage &message) {
+        ++observer_calls; order.push_back(2);
+        assert(message.mcp_source == 272);
+        assert(message.crypto_source == authenticated_source);
+        assert(message.sequence == authenticated_sequence && message.opcode == 0x73);
+        assert(message.payload_len == 10);
+        timestamp = message.received_ms;
+        copied.assign(message.payload, message.payload + message.payload_len);
+    };
+    // Native-only dispatch is unchanged.
+    feed_notify(ctx, Characteristic::High, frame, sizeof(frame), 10);
+    assert(native_calls == 1 && observer_calls == 0 && decrypt_calls == 1);
+    set_rx_observer(ctx, observer);
+    order.clear();
+    feed_notify(ctx, Characteristic::High, frame, sizeof(frame), 20);
+    assert((order == std::vector<int>{1, 2}));
+    assert(timestamp == 20 && decrypt_calls == 2); // One authentication per message.
+    frame[9] = 1;
+    assert(copied[6] == 255); // Observer explicitly copied the borrowed bytes.
+    frame[9] = 255;
+    // Original callback remains registered through observer replacement/removal.
+    set_rx_observer(ctx, nullptr);
+    feed_notify(ctx, Characteristic::High, frame, sizeof(frame), 30);
+    assert(native_calls == 3 && observer_calls == 1);
+    set_rx_observer(ctx, observer);
+    for (auto error : {Error::Crypto, Error::HmacMismatch, Error::PacketTooShort,
+                       Error::BufferTooSmall}) {
+        decrypt_error = error;
+        feed_notify(ctx, Characteristic::High, frame, sizeof(frame), 40);
+    }
+    decrypt_error = Error::Ok;
+    feed_notify(ctx, Characteristic::High, frame, 2, 40); // Authenticated but invalid MCP.
+    assert(native_calls == 3 && observer_calls == 1);
+    // Split completion uses HIGH receipt time.
+    feed_notify(ctx, Characteristic::Low, frame, 8, 50);
+    feed_notify(ctx, Characteristic::High, frame + 8, sizeof(frame) - 8, 55);
+    assert(timestamp == 55 && native_calls == 4 && observer_calls == 2);
+    // A delayed LOW flush keeps original receipt time, including clock wrap.
+    feed_notify(ctx, Characteristic::Low, frame, sizeof(frame), 0xfffffff0u);
+    poll(ctx, 200);
+    assert(timestamp == 0xfffffff0u && native_calls == 5 && observer_calls == 3);
+    // Observer-only registration still authenticates and parses.
+    set_rx_callback(ctx, nullptr);
+    feed_notify(ctx, Characteristic::High, frame, sizeof(frame), 60);
+    assert(observer_calls == 4 && native_calls == 5 && timestamp == 60);
+    // Discovery and consumed MASP association handling still run independently.
+    masp_valid = true;
+    unsigned discoveries = 0;
+    ctx.discovering = true;
+    ctx.discovery_cb = [&](const uint8_t *, size_t len, uint32_t hash) {
+        assert(len == 16 && hash == 123); ++discoveries;
+    };
+    uint8_t uuid_frame[17] = {1};
+    decrypt_error = Error::HmacMismatch;
+    feed_notify(ctx, Characteristic::High, uuid_frame, sizeof(uuid_frame), 70);
+    assert(discoveries == 1 && observer_calls == 4);
+    protocol::Context proto;
+    ctx.proto = &proto;
+    const auto before_masp = decrypt_calls;
+    feed_notify(ctx, Characteristic::High, uuid_frame, sizeof(uuid_frame), 80);
+    assert(protocol_calls == 1 && ctx.proto == nullptr && decrypt_calls == before_masp);
+    assert(discoveries == 2 && observer_calls == 4);
+    // Reinitialization clears registrations; failed init cannot retain an observer.
+    assert(init(ctx, write, "test-passphrase") == Error::Ok);
+    assert(!ctx.rx_observer && !ctx.rx_cb && !ctx.discovering && !ctx.proto);
+    set_rx_observer(ctx, observer);
+    key_error = Error::Crypto;
+    assert(init(ctx, write, "test-passphrase") == Error::Crypto);
+    assert(!ctx.rx_observer && !ctx.rx_cb);
+}
